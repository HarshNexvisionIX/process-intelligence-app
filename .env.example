# Copy this file to .env and fill in values. Never commit .env.

# Where uploads and job outputs are stored (relative to the project root)
DATA_DIR=data

# DuckDB resource limits (raise them on bigger machines)
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4

# AI (reports fall back to fixed templates whenever no provider can answer). The AI only ever
# receives verified facts, names and masked text, never rows, case IDs or users.
AI_ENABLED=true
ALLOW_EXTERNAL_AI=true
# Free cloud tiers, routed per task (config/settings.yaml -> ai.routes). Choose each provider's
# model on the "AI settings" page, then run: python scripts/ai_check.py
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Optional single custom endpoint (overrides routing when set; e.g. a paid OpenAI / Azure OpenAI
# key, or a model on your own computer such as Ollama at http://localhost:11434/v1):
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Privacy guard (ALLOW_EXTERNAL_AI above): an AI endpoint outside your network (Gemini, Groq,
# OpenRouter, OpenAI, or an empty LLM_BASE_URL, which means OpenAI) is NOT called unless it is true;
# the fixed-template summary is used instead. localhost, 10.x, 172.16-31.x, 192.168.x
# and hosts ending in .local / .internal / .lan count as your network.

# Langfuse (self-hosted). Leave empty to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# Tracing to a Langfuse server outside your network (e.g. Langfuse Cloud) stays off unless true.
ALLOW_EXTERNAL_LANGFUSE=false
# Self-hosting Langfuse: the Python SDK used here (langfuse 5.x) needs a Langfuse server >= v4.59.0.
# In the Langfuse SERVER's own .env (not this file), set TELEMETRY_ENABLED=false so the
# Langfuse server does not send usage data to Langfuse either.
